# Токен від @BotFather
BOT_TOKEN=123456:ABC-DEF
# ID групи адмінів (дізнатися: додайте бота в групу і надішліть /chat_id)
ADMIN_CHAT_ID=-1001234567890
# Шлях до бази даних
DB_PATH=data/bot.db
# Часовий пояс церкви (для того, щоб минулі події ховалися вчасно)
TIMEZONE=Europe/Kyiv
# Публічна адреса для кнопки «Додати в календар» на iPhone (див. deploy/nginx-philad-bot.conf).
# Порожньо — замість посилання бот надсилає .ics-файл
PUBLIC_URL=
# Де слухає вбудований вебсервер (nginx проксує на нього /cal/)
WEB_HOST=127.0.0.1
WEB_PORT=8080
